// Prisma schema — Tracking Leads IELTS Master
// Thiết kế chi tiết & lý do: xem plans/architecture.txt ở gốc repo

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 1. DANH MỤC (CONFIG_*)
// ---------------------------------------------------------------------------

model Branch {
  code              String  @id
  name              String
  active            Boolean @default(true)
  slaReceiveMinutes Int     @map("sla_receive_minutes")
  slaProcessHours   Int     @map("sla_process_hours")
  note              String?

  fanpages              Fanpage[]
  users                 User[]
  suggestedInteractions Interaction[] @relation("SuggestedBranch")
  assignedInteractions  Interaction[] @relation("AssignedBranch")
  adsCosts              AdsCost[]

  @@map("branches")
}

model Source {
  name         String  @id
  channelGroup String  @map("channel_group")
  sourceGroup  String  @map("source_group")
  requireAdId  Boolean @default(false) @map("require_ad_id")
  active       Boolean @default(true)
  note         String?

  domains      SourceDomain[]
  fanpages     Fanpage[]
  interactions Interaction[]
  adsCosts     AdsCost[]

  @@map("sources")
}

model SourceDomain {
  id         Int    @id @default(autoincrement())
  sourceName String @map("source_name")
  domain     String

  source Source @relation(fields: [sourceName], references: [name], onDelete: Cascade)

  @@unique([sourceName, domain])
  @@map("source_domains")
}

model Fanpage {
  name                String  @id
  defaultSourceName   String  @map("default_source_name")
  suggestedBranchCode String  @map("suggested_branch_code")
  requireAdId         Boolean @default(false) @map("require_ad_id")
  active              Boolean @default(true)
  note                String?

  defaultSource   Source          @relation(fields: [defaultSourceName], references: [name])
  suggestedBranch Branch          @relation(fields: [suggestedBranchCode], references: [code])
  interactions    Interaction[]
  adsCosts        AdsCost[]
  mktPageReports  MktPageReport[]

  @@map("fanpages")
}

model Status {
  name            String  @id
  sortOrder       Int     @map("sort_order")
  isClosingStatus Boolean @default(false) @map("is_closing_status")
  requirePhone    Boolean @default(false) @map("require_phone")
  active          Boolean @default(true)
  note            String?

  allowedRoles StatusAllowedRole[]
  interactions Interaction[]
  customers    Customer[]

  @@map("statuses")
}

model StatusAllowedRole {
  id         Int    @id @default(autoincrement())
  statusName String @map("status_name")
  role       String

  status Status @relation(fields: [statusName], references: [name], onDelete: Cascade)

  @@unique([statusName, role])
  @@map("status_allowed_roles")
}

model CustomerObject {
  name      String  @id
  sortOrder Int     @map("sort_order")
  active    Boolean @default(true)

  interactions Interaction[]

  @@map("customer_objects")
}

model User {
  email             String  @id
  fullName          String  @map("full_name")
  role              String
  branchCode        String? @map("branch_code")
  active            Boolean @default(true)
  viewAllBranches   Boolean @default(false) @map("view_all_branches")
  userKey           String? @map("user_key")
  canCloseMktReport Boolean @default(false) @map("can_close_mkt_report")
  note              String?

  passwordHash       String  @map("password_hash")
  mustChangePassword Boolean @default(true) @map("must_change_password")

  branch                     Branch?         @relation(fields: [branchCode], references: [code])
  assignedInteractions       Interaction[]   @relation("AssignedSale")
  slaFlaggedInteractions     Interaction[]   @relation("SlaFlaggedBy")
  createdInteractions        Interaction[]   @relation("CreatedBy")
  updatedInteractions        Interaction[]   @relation("UpdatedBy")
  reassignedInteractions     Interaction[]   @relation("ReassignedBy")
  followupInteractions       Interaction[]   @relation("FollowupHandledBy")
  mktPushedInteractions      Interaction[]   @relation("MktPushedBy")
  followupTargetInteractions Interaction[]   @relation("FollowupTargetSale")
  systemLogs                 SystemLog[]
  closedMktPageReports       MktPageReport[] @relation("ClosedMktPageReport")
  sentEmailMessages          EmailMessage[]

  saleLeadStat SaleLeadStat?

  customersAssignedTo Customer[]        @relation("CustomerAssignedTo")
  customersAssignedBy Customer[]        @relation("CustomerAssignedBy")
  customersUpdatedBy  Customer[]        @relation("CustomerUpdatedBy")
  customerCareLogs    CustomerCareLog[]

  @@map("users")
}

model AppSetting {
  id          Int     @id @default(autoincrement())
  configGroup String  @map("config_group") // "duplicate" | "system"
  key         String
  value       String
  description String?

  @@unique([configGroup, key])
  @@map("app_settings")
}

// Đếm riêng số lần Sale tạo liên hệ + số lần tạo ra đã Đủ điều kiện ngay lúc
// tạo (có SĐT) — tách khỏi User để không phình thêm cột đếm vào đó, và tách
// khỏi việc query Interaction trực tiếp (đơn giản, nhanh, không phụ thuộc
// logic lọc/scope khác). Cập nhật duy nhất tại createInteraction() (mutations.ts).
model SaleLeadStat {
  saleEmail      String @id @map("sale_email")
  totalCreated   Int    @default(0) @map("total_created")
  totalQualified Int    @default(0) @map("total_qualified")

  sale User @relation(fields: [saleEmail], references: [email])

  @@map("sale_lead_stats")
}

// Phân quyền theo tính năng + vai trò — Admin cấu hình ở /admin/permissions
// (xem app/(app)/admin/permissions/permission-types.ts cho danh sách
// feature/role/action hợp lệ). 1 dòng/(feature, role), 4 cột hành động
// Thêm/Sửa/Xóa/Báo cáo — khớp 1:1 với bảng hiển thị trên UI. Admin luôn có
// đủ quyền mặc định nên KHÔNG có dòng riêng ở đây (xem require-admin.ts).
model FeaturePermission {
  feature   String
  role      String
  canCreate Boolean @default(false) @map("can_create")
  canEdit   Boolean @default(false) @map("can_edit")
  canDelete Boolean @default(false) @map("can_delete")
  canReport Boolean @default(false) @map("can_report")

  @@id([feature, role])
  @@map("feature_permissions")
}

// ---------------------------------------------------------------------------
// 2. NGHIỆP VỤ LÕI
// ---------------------------------------------------------------------------

model Customer {
  customerKey       String   @id @map("customer_key")
  displayName       String   @map("display_name")
  canonicalLink     String   @unique @map("canonical_link")
  phoneNormalized   String?  @map("phone_normalized")
  firstTouchAt      DateTime @map("first_touch_at")
  lastTouchAt       DateTime @map("last_touch_at")
  currentStatusName String   @map("current_status_name")

  // -------------------------------------------------------------------------
  // TƯ VẤN GHI DANH — mirror logic StudentProfile cũ (đã gỡ, xem lịch sử
  // chat/commit) nhưng gắn thẳng vào Customer thay vì 1 bản profile tách rời
  // liên kết mềm qua interactionId — Customer vốn đã là danh tính duy nhất
  // của khách (gộp theo canonicalLink) nên không cần thêm 1 tầng định danh
  // nữa. KHÔNG đụng gì tới Interaction — coi như xong việc khi khách đã Đủ
  // tiêu chuẩn, phần tư vấn ghi danh từ đây là câu chuyện riêng của Customer.
  // -------------------------------------------------------------------------
  age           Int?
  dateOfBirth   DateTime? @map("date_of_birth")
  gender        String?
  parentName    String?   @map("parent_name")
  address       String?
  level         String?
  trainingTrack String?   @map("training_track")
  school        String?
  aspiration    String?

  // Mốc xa nhất Sale đã đạt được trong phễu tư vấn (Đã gọi/Quan tâm/Không
  // quan tâm/Đặt lịch test/Đã test/Đặt lịch học thử/Đã học thử/Đã chốt) — xem
  // CUSTOMER_STAGE trong lib/interactions/constants.ts. null = chưa gán/chưa
  // gọi lần nào. Không có "trạng thái rớt" riêng — dùng stageReason để giải
  // thích vì sao đang dừng ở 1 mốc bất kỳ.
  stage              String?
  stageReason        String?   @map("stage_reason")
  // Mốc thời gian THỰC SỰ chuyển sang "Đã chốt" — set đúng 1 lần lúc stage đổi
  // sang ENROLLED, KHÔNG dùng chung updatedAt (bị bump bởi bất kỳ chỉnh sửa
  // nào khác nên không đáng tin cho việc tính KPI theo ngày/tuần/tháng cụ thể).
  enrolledAt         DateTime? @map("enrolled_at")
  // Case đang kẹt (mirror sheet "Khách kẹt"): hạn xử lý tiếp theo Sale tự đặt,
  // và cờ Sale bật khi cần Leader can thiệp.
  caseDeadline       DateTime? @map("case_deadline")
  needsLeaderSupport Boolean   @default(false) @map("needs_leader_support")
  // Ngày hẹn cụ thể — chỉ có ý nghĩa khi stage = "Đặt lịch test"/"Đặt lịch học
  // thử", cho phép tự phát hiện "quá hạn hẹn mà chưa cập nhật kết quả".
  appointmentAt      DateTime? @map("appointment_at")

  // null = Leader chưa phân bổ cho Sale nào — chỉ có giá trị SAU khi Leader
  // phân bổ ở /customer-assignment (khác lúc mới trở thành Customer).
  assignedToEmail String?   @map("assigned_to_email")
  assignedByEmail String?   @map("assigned_by_email")
  assignedAt      DateTime? @map("assigned_at")

  note           String?
  updatedByEmail String?   @map("updated_by_email")
  updatedAt      DateTime? @map("updated_at")

  currentStatus Status            @relation(fields: [currentStatusName], references: [name])
  interactions  Interaction[]
  assignedTo    User?             @relation("CustomerAssignedTo", fields: [assignedToEmail], references: [email])
  assignedBy    User?             @relation("CustomerAssignedBy", fields: [assignedByEmail], references: [email])
  updatedBy     User?             @relation("CustomerUpdatedBy", fields: [updatedByEmail], references: [email])
  careLogs      CustomerCareLog[]

  @@index([assignedToEmail])
  @@map("customers")
}

// Nhật ký chăm sóc — mỗi lần Sale gọi điện là 1 dòng, tách riêng khỏi Customer
// vì là dữ liệu lặp theo thời gian (không dùng chung SystemLog của Interaction
// — Customer đã tách khỏi Interaction ở tính năng này).
model CustomerCareLog {
  id             String   @id @default(cuid())
  customerKey    String   @map("customer_key")
  loggedAt       DateTime @default(now()) @map("logged_at")
  loggedByEmail  String   @map("logged_by_email")
  content        String
  stageAtLogTime String?  @map("stage_at_log_time")

  customer Customer @relation(fields: [customerKey], references: [customerKey])
  loggedBy User     @relation(fields: [loggedByEmail], references: [email])

  @@index([customerKey])
  @@map("customer_care_logs")
}

model Interaction {
  interactionId String   @id @map("interaction_id")
  // Chỉ có giá trị khi liên hệ đã Đủ tiêu chuẩn (có SĐT) — lúc đó mới có dòng
  // Customer tương ứng (xem createInteraction()/updateStatus() trong
  // mutations.ts). Liên hệ đang Chờ/Tiếp nhận/Spam-chưa-từng-đủ-điều-kiện thì
  // customerKey = null, KHÔNG ghi vào bảng customers.
  customerKey   String?  @map("customer_key")
  version       Int      @default(1)
  activeFlag    Boolean  @default(true) @map("active_flag")
  createdLeadAt DateTime @map("created_lead_at")

  sourceName     String  @map("source_name")
  fanpageName    String  @map("fanpage_name")
  adId           String? @map("ad_id")
  firstTouchAdId String? @map("first_touch_ad_id")
  lastTouchAdId  String? @map("last_touch_ad_id")

  rawLink       String @map("raw_link")
  canonicalLink String @map("canonical_link")
  customerName  String @map("customer_name")

  customerObjectName  String @map("customer_object_name")
  suggestedBranchCode String @map("suggested_branch_code")
  assignedBranchCode  String @map("assigned_branch_code")
  statusName          String @map("status_name")

  interactionType String @map("interaction_type")

  assignedSaleEmail String? @map("assigned_sale_email")

  // Admin rà soát trang "Rà soát SLA" và tick đánh dấu ghi nhận — chỉ để theo
  // dõi/báo cáo trách nhiệm, KHÔNG đổi trạng thái hay hành vi nào khác của
  // liên hệ (xem lib/interactions/sla.ts).
  slaFlagged        Boolean   @default(false) @map("sla_flagged")
  slaFlaggedAt      DateTime? @map("sla_flagged_at")
  slaFlaggedByEmail String?   @map("sla_flagged_by_email")

  receivedAt      DateTime? @map("received_at")
  phoneRaw        String?   @map("phone_raw")
  phoneNormalized String?   @map("phone_normalized")
  phoneCapturedAt DateTime? @map("phone_captured_at")
  closedAt        DateTime? @map("closed_at")

  transferredToPse Boolean @default(false) @map("transferred_to_pse")
  pseProfileCode   String? @map("pse_profile_code")

  createdByEmail String    @map("created_by_email")
  createdAt      DateTime  @map("created_at")
  updatedByEmail String?   @map("updated_by_email")
  updatedAt      DateTime? @map("updated_at")

  reassignedByEmail String? @map("reassigned_by_email")
  reassignReason    String? @map("reassign_reason")

  needsFollowup Boolean @default(false) @map("needs_followup")

  mktPushedAt             DateTime? @map("mkt_pushed_at")
  mktPushedByEmail        String?   @map("mkt_pushed_by_email")
  // Sale CỤ THỂ được chọn để nhận yêu cầu chăm sóc lại — bắt buộc chọn khi
  // gửi mới ở /followup. null = đã gắn cờ needsFollowup nhưng chưa gắn Sale
  // (case cũ trước khi có field này, hoặc do dữ liệu lỗi) — vẫn hiện lại ở
  // /followup để Leader/Marketing gắn Sale bù. /followup-inbox của 1 Sale chỉ
  // hiện đúng những dòng nhắm tới email của họ.
  followupTargetSaleEmail String?   @map("followup_target_sale_email")

  conversationLink String? @map("conversation_link")
  mktSuggestion    String? @map("mkt_suggestion")

  followupHandledByEmail String?   @map("followup_handled_by_email")
  followupHandledAt      DateTime? @map("followup_handled_at")
  // "STATUS_CHANGED": Sale xử lý xong yêu cầu chăm sóc lại — tắt cờ needsFollowup
  // kèm tiến triển thật (đổi trạng thái nghiệp vụ, hoặc bị ép về "Tiếp nhận" qua
  // resolveFollowup() trong mutations.ts). "MANUAL_DISMISS": giá trị lịch sử cũ
  // (trước khi resolveFollowup() luôn buộc tiến triển thật) — không còn phát
  // sinh mới, chỉ còn ở các bản ghi cũ.
  followupOutcome        String?   @map("followup_outcome")
  // Đếm dồn số lần MARKETING gửi yêu cầu "Chăm sóc lại" cho liên hệ này qua suốt
  // vòng đời (xem pushFollowup() trong mutations.ts) — KHÔNG còn đếm số lần Sale
  // xử lý như trước. Chỉ dùng để hiển thị/lọc "Sắp chuyển Spam" ở /followup-inbox,
  // không tự động đổi trạng thái.
  followupResolvedCount  Int       @default(0) @map("followup_resolved_count")

  customer           Customer?      @relation(fields: [customerKey], references: [customerKey])
  source             Source         @relation(fields: [sourceName], references: [name])
  fanpage            Fanpage        @relation(fields: [fanpageName], references: [name])
  customerObject     CustomerObject @relation(fields: [customerObjectName], references: [name])
  suggestedBranch    Branch         @relation("SuggestedBranch", fields: [suggestedBranchCode], references: [code])
  assignedBranch     Branch         @relation("AssignedBranch", fields: [assignedBranchCode], references: [code])
  status             Status         @relation(fields: [statusName], references: [name])
  assignedSale       User?          @relation("AssignedSale", fields: [assignedSaleEmail], references: [email])
  slaFlaggedBy       User?          @relation("SlaFlaggedBy", fields: [slaFlaggedByEmail], references: [email])
  createdBy          User           @relation("CreatedBy", fields: [createdByEmail], references: [email])
  updatedBy          User?          @relation("UpdatedBy", fields: [updatedByEmail], references: [email])
  reassignedBy       User?          @relation("ReassignedBy", fields: [reassignedByEmail], references: [email])
  followupHandledBy  User?          @relation("FollowupHandledBy", fields: [followupHandledByEmail], references: [email])
  mktPushedBy        User?          @relation("MktPushedBy", fields: [mktPushedByEmail], references: [email])
  followupTargetSale User?          @relation("FollowupTargetSale", fields: [followupTargetSaleEmail], references: [email])

  systemLogs      SystemLog[]
  emailMessages   EmailMessageInteraction[]
  fieldChangeLogs InteractionFieldLog[]

  @@index([customerKey])
  @@index([statusName])
  @@index([assignedSaleEmail])
  @@index([assignedBranchCode])
  @@index([createdLeadAt])
  @@map("interactions")
}

// Mỗi dòng = 1 email THẬT SỰ đã gửi đi (1 Message-ID) — kể cả khi 1 email gộp
// thông báo cho nhiều liên hệ cùng lúc (vd phân bổ hàng loạt cho 1 Sale).
// Là nguồn sự thật để: (1) tất cả người xem được liên hệ này cũng xem được
// lịch sử email đã gửi về nó (không chỉ người trực tiếp bấm gửi), và (2) mọi
// dịch vụ gửi mail sau này tra cứu Message-ID gốc của liên hệ để reply-vào
// (In-Reply-To/References) thay vì tạo hội thoại mới mỗi lần — xem sendEmail()
// trong lib/email.ts, đây là nơi DUY NHẤT nên ghi/đọc bảng này.
model EmailMessage {
  id          String   @id @default(cuid())
  messageId   String   @unique @map("message_id")
  toEmail     String   @map("to_email")
  bccEmails   String[] @map("bcc_emails")
  subject     String
  html        String
  // Tag nghiệp vụ đã tạo ra email này (mirror SYSTEM_LOG_ACTION, vd
  // "FOLLOWUP_ASSIGN", "SEND_BROADCAST_EMAIL") — để lọc/hiển thị theo ngữ cảnh.
  action      String
  sentByEmail String?  @map("sent_by_email")
  sentAt      DateTime @default(now()) @map("sent_at")

  sentBy       User?                     @relation(fields: [sentByEmail], references: [email])
  interactions EmailMessageInteraction[]

  @@index([sentAt])
  @@map("email_messages")
}

// Bảng nối nhiều-nhiều EmailMessage <-> Interaction (1 email có thể gộp
// nhiều liên hệ; 1 liên hệ có thể xuất hiện trong nhiều email theo thời gian)
// — dùng bảng nối để giữ được FK/index chuẩn như phần còn lại của schema.
model EmailMessageInteraction {
  id             String @id @default(cuid())
  emailMessageId String @map("email_message_id")
  interactionId  String @map("interaction_id")

  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  interaction  Interaction  @relation(fields: [interactionId], references: [interactionId], onDelete: Cascade)

  @@unique([emailMessageId, interactionId])
  @@index([interactionId])
  @@map("email_message_interactions")
}

// Nhật ký thay đổi từng field của Interaction khi Sửa thông tin (chỉ ghi khi
// GHI ĐÈ 1 giá trị đã có sẵn — điền lần đầu vào field đang trống KHÔNG tính
// là "thay đổi" nên không ghi — xem updateInteractionInfo() trong
// mutations.ts). Dùng để hiển thị lịch sử sửa ở trang chi tiết liên hệ, và
// sau này thống kê theo field/theo người sửa. fieldLabel/changedByName
// denormalized tại thời điểm ghi để hiển thị không phụ thuộc map nhãn hay tên
// User có thể đổi khác đi sau này.
// Nguồn sự thật DUY NHẤT cho "lịch sử của 1 liên hệ" — không chỉ sửa field
// nữa. `fieldKey` mang 1 trong 2 vai trò tuỳ loại dòng: tên field thật khi
// loại là sửa thông tin ("rawLink" | "customerName" | "fanpageName" |
// "conversationLink" | "adId" | "customerObjectName" | "assignedBranchCode"),
// hoặc mã hành động chung khi là hoạt động khác trên liên hệ ("TOUCH" |
// "STATUS_CHANGE" | "FOLLOWUP_PUSH" | "FOLLOWUP_ASSIGN" | "FOLLOWUP_RESOLVED"
// | "REASSIGN") — `fieldLabel` luôn là nhãn tiếng Việt hiển thị tương ứng.
// `note` chỉ dùng cho loại hoạt động (ghi chú tự do của actor), field-edit
// không dùng tới. SystemLog vẫn giữ vai trò nhật ký audit TOÀN HỆ THỐNG
// (/logs) — bảng này riêng cho đúng 1 liên hệ, hiển thị trên trang chi tiết
// của nó (Lịch sử chăm sóc / Lịch sử chăm sóc lại / Lịch sử chỉnh sửa).
model InteractionFieldLog {
  id             String   @id @default(cuid())
  interactionId  String   @map("interaction_id")
  fieldKey       String   @map("field_key")
  fieldLabel     String   @map("field_label")
  oldValue       String?  @map("old_value")
  newValue       String?  @map("new_value")
  note           String?  @map("note")
  changedByEmail String   @map("changed_by_email")
  changedByName  String   @map("changed_by_name") // denormalized tại thời điểm ghi — tên hiển thị không đổi ngược theo User nếu sau này actor đổi tên
  changedAt      DateTime @default(now()) @map("changed_at")

  interaction Interaction @relation(fields: [interactionId], references: [interactionId], onDelete: Cascade)

  @@index([interactionId])
  @@index([fieldKey])
  @@map("interaction_field_logs")
}

// ---------------------------------------------------------------------------
// 3. TÀI CHÍNH / MARKETING
// ---------------------------------------------------------------------------

model AdsCost {
  id             Int      @id @default(autoincrement())
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  adId           String   @map("ad_id")
  adName         String   @map("ad_name")
  sourceName     String?  @map("source_name")
  fanpageName    String?  @map("fanpage_name")
  branchCode     String?  @map("branch_code")
  costVnd        Decimal  @default(0) @map("cost_vnd") @db.Decimal(14, 2)
  note           String?
  updatedByEmail String?  @map("updated_by_email")
  updatedAt      DateTime @map("updated_at")

  // Từ file report Facebook Ads Manager (Campaign name/Ad set name/Media
  // type/Result type/Results/Impressions/Post engagements/Link clicks/
  // Messaging conversations/ThruPlays) — chỉ điền được qua "Nhập chi phí từ
  // Excel" khi nhập đúng file export từ Ads Manager; nhập tay thủ công thì để
  // trống. "results"/"resultType" chỉ mang tính tham khảo hiển thị vì ý
  // nghĩa "Results" đổi theo mục tiêu tối ưu của từng quảng cáo, không dùng
  // để tính toán gì cứng.
  campaignName           String? @map("campaign_name")
  adSetName              String? @map("ad_set_name")
  mediaType              String? @map("media_type")
  resultType             String? @map("result_type")
  results                Int?
  resultsInitial         Int?    @map("results_initial")
  impressions            Int?
  postEngagements        Int?    @map("post_engagements")
  linkClicks             Int?    @map("link_clicks")
  messagingConversations Int?    @map("messaging_conversations")
  thruPlays              Int?    @map("thru_plays")

  source  Source?  @relation(fields: [sourceName], references: [name])
  fanpage Fanpage? @relation(fields: [fanpageName], references: [name])
  branch  Branch?  @relation(fields: [branchCode], references: [code])

  @@index([adId])
  @@map("ads_cost")
}

// Báo cáo Page hằng ngày — cohort theo ngày TẠO lead (không phải ngày xin được
// SĐT), nên lead cũ xin SĐT hôm nay chỉ cộng vào report của ngày nó được tạo.
// Trước khi chốt: totalLeads/qualifiedLeads = null, số liệu đọc trực tiếp từ
// Interaction. Sau khi chốt (closedAt có giá trị): đọc 2 cột này làm snapshot
// cố định, không tính lại nữa dù dữ liệu gốc có đổi.
model MktPageReport {
  id             Int       @id @default(autoincrement())
  reportDate     DateTime  @map("report_date") @db.Date
  fanpageName    String    @map("fanpage_name")
  totalLeads     Int?      @map("total_leads")
  qualifiedLeads Int?      @map("qualified_leads")
  closedAt       DateTime? @map("closed_at")
  closedByEmail  String?   @map("closed_by_email")

  fanpage  Fanpage @relation(fields: [fanpageName], references: [name])
  closedBy User?   @relation("ClosedMktPageReport", fields: [closedByEmail], references: [email])

  @@unique([reportDate, fanpageName])
  @@map("mkt_page_reports")
}

// ---------------------------------------------------------------------------
// 4. AUDIT LOG
// ---------------------------------------------------------------------------

model SystemLog {
  logId         String   @id @map("log_id")
  loggedAt      DateTime @map("logged_at")
  actorEmail    String?  @map("actor_email")
  actorName     String   @map("actor_name")
  actorRole     String   @map("actor_role")
  action        String
  interactionId String?  @map("interaction_id")
  detailOld     Json?    @map("detail_old")
  detailNew     Json?    @map("detail_new")
  result        String
  technicalInfo String?  @map("technical_info")

  actor       User?        @relation(fields: [actorEmail], references: [email])
  interaction Interaction? @relation(fields: [interactionId], references: [interactionId])

  @@index([loggedAt])
  @@index([interactionId])
  @@map("system_log")
}
