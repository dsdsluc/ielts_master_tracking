# Sao chép file này thành .env (local) hoặc khai báo tương ứng trong
# Vercel → Project Settings → Environment Variables (production).

# Chuỗi kết nối Postgres. Đang dùng Neon — nhớ dùng đúng connection string
# dạng "pooler" (có "-pooler" trong host) để chạy ổn định trên serverless
# (Vercel) thay vì connection string trực tiếp, tránh cạn kết nối DB.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require"

# Khoá ký JWT phiên đăng nhập — chuỗi ngẫu nhiên, giữ bí mật, KHÔNG dùng lại
# giá trị ở môi trường dev cho production. Tạo nhanh bằng:
#   openssl rand -base64 32
SESSION_SECRET="<chuỗi ngẫu nhiên ít nhất 32 ký tự>"

# Upstash Redis (cache dashboard/báo cáo) — tạo qua Vercel Marketplace
# (Storage → Upstash), Vercel tự tiêm 2 biến này vào Production/Preview.
# Local: `vercel env pull .env.local` hoặc copy tay từ Vercel dashboard.
# Optional — thiếu 2 biến này thì cache tự tắt (fallback query thẳng DB).
KV_REST_API_URL="https://xxxxx.upstash.io"
KV_REST_API_TOKEN="<token>"
